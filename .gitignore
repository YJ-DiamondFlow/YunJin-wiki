# ==========================================================================
# YunJin-wiki · .gitignore
# ==========================================================================

# ---------------- Node / 前端 ----------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
*.tsbuildinfo

# 包管理器日志与缓存
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# ---------------- Python / 后端 ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# 打包 / 测试缓存
build/
develop-eggs/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------- 配置与密钥 ----------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
config.local.*

# ---------------- 本地临时产物 ----------------
.preview/
.probe/
.shots/
.tmp/
*.log
.test_*.py
.cleanup*.py

# ---------------- 编辑器 / IDE ----------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------- 操作系统 ----------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
